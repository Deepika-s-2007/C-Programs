#include <stdio.h>

int main() {
    char name[50];
    int age, quantity;
    float price;

    scanf("%s ", name);   
    scanf("%d ", &age);
    scanf("%d ", &quantity);
    scanf("%f ", &price);

    printf("Name:  %s\n", name);
    printf("Age:  %d\n", age);
    printf("Product Quantity:  %d\n", quantity);
    printf("Price: %.2f\n", price);  

    return 0;
}
